# ========================================================================
# XThing — production env для docker-compose.yml
# Скопировать в .env.docker и заполнить.   chmod 600 .env.docker
# Никогда не коммитить .env.docker — он в .gitignore.
# ========================================================================

# --- Домены и Let's Encrypt ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
LE_EMAIL=admin@example.com

# --- Postgres ---
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgres://xthing:replace-with-strong-password@postgres:5432/xthing

# --- Redis ---
REDIS_PASSWORD=replace-with-strong-password
REDIS_URL=redis://:replace-with-strong-password@redis:6379

# --- JWT секреты (32 байта = 64 hex) ---
# Генерация: openssl rand -hex 32
JWT_ACCESS_SECRET=GENERATE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=GENERATE_ME_openssl_rand_hex_32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- AES-256 ключ для шифрования конфигов серверов ---
# КРИТИЧНО: при потере все шифры в БД станут мусором.
# Сгенерировать ОДИН РАЗ и хранить в менеджере паролей.
# openssl rand -hex 32
SERVER_CONFIG_AES_KEY=GENERATE_ME_openssl_rand_hex_32

# --- Прочее ---
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://app.example.com
