<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Все VPN-разрешения и регистрация XThingVpnService живут в
        app-манифесте проекта-потребителя
        (android/app/src/main/AndroidManifest.xml).
        Здесь специально пусто, чтобы manifest merger не получал
        дубликатов uses-permission и <service>.

        Если этот плагин будет переиспользоваться в другом проекте —
        потребитель должен скопировать в свой AndroidManifest.xml:
          - uses-permission:
              INTERNET, ACCESS_NETWORK_STATE,
              FOREGROUND_SERVICE, FOREGROUND_SERVICE_SPECIAL_USE,
              POST_NOTIFICATIONS
          - service com.xthing.vpn.XThingVpnService с
              android:permission="android.permission.BIND_VPN_SERVICE",
              android:foregroundServiceType="specialUse",
              intent-filter android.net.VpnService,
              property android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE="vpn".
    -->
</manifest>
