{
  "name": "@xthing/electron",
  "version": "1.0.0",
  "private": true,
  "description": "XThing VPN — desktop client",
  "author": {
    "name": "XThing",
    "email": "support@xthing.local"
  },
  "main": "dist/main.js",
  "productName": "XThing VPN",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json && node scripts/copy-proto.cjs && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-proto.cjs",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "dist": "electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.1",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.5",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "@types/node": "^20.14.10",
    "cross-env": "^7.0.3",
    "electron": "31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4"
  }
}
